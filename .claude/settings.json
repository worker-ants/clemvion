{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/tools/bootstrap-session.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_mermaid_posttooluse.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_default_branch_edit.py\""
          },
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_nerv_owned_paths.py\" || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_nerv_owned_paths.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"; if [ -f \"$d/pretooluse_bash.py\" ]; then exec python3 \"$d/pretooluse_bash.py\"; fi; p=$(cat); printf '%s' \"$p\" | python3 \"$d/guard_default_branch_bash.py\"; printf '%s' \"$p\" | python3 \"$d/normalize_worktree_branch.py\"; printf '%s' \"$p\" | python3 \"$d/guard_review_before_push.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_default_branch_prompt.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/normalize_worktree_branch.py\""
          }
        ]
      }
    ]
  }
}
